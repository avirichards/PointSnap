# ── Database (Supabase Postgres — project cgoyetahoktqupkcvrli) ──────────────
# Pooled (app runtime) + unpooled (migrations / drizzle-kit, long transactions).
DATABASE_URL="postgresql://postgres:pass@db.<ref>.supabase.co:6543/postgres?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://postgres:pass@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# ── Supabase Auth + service role ─────────────────────────────────────────────
# Public (browser) + anon key power sign-in/up and RLS-scoped reads.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never exposed to the browser. Used by server actions / worker
# for privileged writes (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=""

# ── Python scraper worker bridge ─────────────────────────────────────────────
# Base URL of the deployed FastAPI worker. /api/search, /api/programs-meta and
# /api/auth/airline/* proxy to it. Unset → /search streams zero live rows
# (chart-only estimates still render).
PYTHON_WORKER_URL="https://pointsnap-workers.fly.dev"

# ── Redis (Upstash REST) ─────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ── Auth dev + ops ───────────────────────────────────────────────────────────
# Fallback user id when no real session is present (dev-only exercise of the
# airline-connect flow). Set to a real auth.users UUID to test end-to-end.
POINTSNAP_AUTH_DEV_USER_ID=""
# Guards the /api/admin/seed endpoint.
SEED_TOKEN=""

# ── Stripe — wired but inactive at launch (feature flag in lib/features.ts) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PAYWALL="false"

# NOTE: Auth is Supabase Auth (self-contained). The legacy Clerk env vars
# (NEXT_PUBLIC_CLERK_*/CLERK_SECRET_KEY) are no longer required.
