# Postgres (Neon serverless)
DATABASE_URL="postgresql://user:pass@host.neon.tech/pointsnap?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.neon.tech/pointsnap?sslmode=require"

# Redis (Upstash REST)
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# Clerk auth — leave blank to skip Clerk in dev; auth screens render in shell mode
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Stripe — wired but inactive at launch (feature flag in lib/features.ts)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Feature flags
NEXT_PUBLIC_ENABLE_PAYWALL="false"

# Python worker bridge (see python-workers/). When set, /api/search calls
# this for the programs listed in WORKER_PROGRAMS instead of using the
# mock dataset. Leave blank in local dev to keep the cockpit fully mocked.
PYTHON_WORKER_URL=""
