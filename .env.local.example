# Direct Alaska, JetBlue, and Virgin Atlantic searches work with all values blank.
# Never put provider keys or worker tokens in NEXT_PUBLIC_* variables.

# PointSnap accounts + private wallet (Supabase Auth / PostgREST / RLS).
# Apply supabase/migrations/20260905010000_personal_wallet.sql first.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional app-owned live award-data integrations.
# Seats.aero Live Search requires a commercial agreement; Pro does not include it.
SEATS_AERO_API_KEY=""
# AwardTool requires API access. Confirm enabled programs with your contract.
AWARDTOOL_API_KEY=""
AWARDTOOL_PROGRAMS="QF,AC,UA,AA,AS,AV,B6,VA,VS"

# Required in production when either paid provider is enabled.
# Quota is enforced per verified PointSnap user, 20 searches / 10 minutes.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional browser service: American, Delta and Smiles have verified local responses.
# Each host must be qualified before enabling it. See browser-worker/README.md.
POINTSNAP_BROWSER_AMERICAN="0"
POINTSNAP_BROWSER_DELTA="0"
POINTSNAP_BROWSER_SMILES="0"
POINTSNAP_BROWSER_ETIHAD="0"
POINTSNAP_BROWSER_SOUTHWEST="0"
POINTSNAP_BROWSER_WORKER_URL=""
POINTSNAP_BROWSER_WORKER_TOKEN=""

# Optional legacy operator database. Not needed for direct searches or wallet.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# Optional legacy worker, for managing previously saved airline sessions.
# These must match the worker deployment. Current search does not use the worker.
PYTHON_WORKER_URL=""
POINTSNAP_WORKER_TOKEN=""
# Worker-only, separate authorization for /diag and API documentation.
POINTSNAP_WORKER_ADMIN_TOKEN=""
# Optional POST /api/admin/seed, passed as Authorization: Bearer <token>.
SEED_TOKEN=""

# Anonymous SAS search through the owned browser worker
POINTSNAP_BROWSER_SAS=0
POINTSNAP_BROWSER_COPA=0
